# Required: your Google Gemini API key.
# Get one free (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Optional: models to try when the primary one hits its daily quota.
# Gemini counts quota per project PER MODEL, so a sibling model has its own
# untouched allowance — and unlike an external provider it keeps web search
# and file uploads working.
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite

# Optional: which Gemini model to use.
# gemini-2.5-flash is the free-tier workhorse. gemini-2.5-pro is stronger but
# has a much smaller free quota.
# GEMINI_MODEL=gemini-2.5-flash

# Optional: how hard the model thinks - low | medium | high (default: high).
# "low" disables thinking entirely, which is faster and uses less quota.
# AI_EFFORT=high

# Optional: max upload size in MB (default 4).
# Vercel caps a serverless request body at ~4.5 MB. Raise this when self-hosting.
# NEXT_PUBLIC_MAX_UPLOAD_MB=20

# ---------------------------------------------------------------------------
# Optional backup providers. When Gemini's free quota runs out for the day,
# the app automatically continues on the first one of these that is configured,
# which multiplies how much you can do per day for free.
#
# These are text-only: no web-search citations and no file uploads, so requests
# that need either stay on Gemini and report the quota error honestly.
#
# Model IDs change often — override them if a provider retires one.
# ---------------------------------------------------------------------------

# Groq — free, no card, very fast.  https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# Cerebras — free, no card.  https://cloud.cerebras.ai
# CEREBRAS_API_KEY=csk-...
# CEREBRAS_MODEL=llama-3.3-70b

# OpenRouter — free models carry a ":free" suffix.  https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Mistral — free experimental tier.  https://console.mistral.ai
# MISTRAL_API_KEY=...
# MISTRAL_MODEL=mistral-large-latest

# GitHub Models — free with a GitHub token, but only 8K input tokens,
# so it suits short chats rather than long sources.
# GITHUB_MODELS_TOKEN=ghp_...
# GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# Order to try them in (default: the order they appear above).
# FALLBACK_ORDER=groq,cerebras,openrouter
